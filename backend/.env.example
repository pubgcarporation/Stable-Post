# Must match Vite dev proxy (frontend defaults to http://127.0.0.1:PORT). Railway sets PORT automatically.
PORT=3000
# Local: omit (uses backend/uploads). Render Free: use Cloudinary (free tier) so images persist:
# https://cloudinary.com/users/register_free
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# Optional local disk override (Render paid + persistent disk):
# UPLOADS_DIR=/data/uploads
# Comma-separated origins if browser calls API directly (e.g. VITE_API_URL). Empty = allow any origin.
# CORS_ORIGIN=https://your-frontend.up.railway.app,http://localhost:5173
CORS_ORIGIN=
# PostgreSQL (local Docker: postgresql://postgres:dev@localhost:5432/stablepost). On Railway, link a Postgres plugin and use its DATABASE_URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
JWT_SECRET=
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_CHAIN_ID=5042002
USDC_ADDRESS=0x3600000000000000000000000000000000000000
STABLEPOST_ADDRESS=
# Circle Developer-Controlled Wallets (optional; all three required to provision custodial Arc wallets)
# API key must be three parts: ENV:keyId:secret (e.g. TEST_API_KEY:xxxxxxxx:yyyyyyyy).
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_SET_ID=
